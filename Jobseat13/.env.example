# Supabase Session Pooler — gunakan port 5432 karena aplikasi memakai PDO prepared statements.
DB_HOST=aws-0-REGION.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.PROJECT_REF
DB_PASS=YOUR_SUPABASE_DATABASE_PASSWORD
DB_SSLMODE=require

# Deplexo
PORT=3000

# Opsional jika aplikasi dipasang di subpath.
# Untuk subdomain Deplexo langsung, biarkan kosong.
APP_BASE_URL=
